@[expose] public section

/-! Source module: HigherCellAttachment.Adjunction -/
section HigherCellAttachment_Adjunction




/-!
# Genuine adjunction space for an arbitrary family of higher-cells

The carrier is the quotient of the topological disjoint union of the original
space and the indexed closed Euclidean closed unit balls. The relation is generated by
exactly the prescribed boundary identifications; the topology is the quotient
topology. No separation or finiteness assumptions are used.
-/

noncomputable section

namespace HigherCellAttachment

universe u v

abbrev Euclid (n : ℕ) := EuclideanSpace ℝ (Fin n)
abbrev Sphere (n : ℕ) := Metric.sphere (0 : Euclid n) 1
abbrev Disk (n : ℕ) := {z : Euclid n // ‖z‖ ≤ 1}
namespace Sphere
@[simp] theorem norm_coe {n : ℕ} (z : Sphere n) : ‖(z : Euclid n)‖ = 1 :=
  mem_sphere_zero_iff_norm.mp z.property
theorem coe_ne_zero {n : ℕ} (z : Sphere n) : (z : Euclid n) ≠ 0 :=
  norm_ne_zero_iff.mp (by rw [norm_coe]; norm_num)
end Sphere
/-- The actual unit sphere boundary included in its closed ball. -/
def boundaryInclusion {n : ℕ} : C(Sphere n, Disk n) where
  toFun z := ⟨z, le_of_eq (Sphere.norm_coe z)⟩
  continuous_toFun := by fun_prop

/-- The actual topological disjoint union before attaching the disks. -/
abbrev Raw (X : Type u) {ι : Type v} (d : ι → ℕ) := X ⊕ (Σ i : ι, Disk (d i))

variable {X : Type u} [TopologicalSpace X] {ι : Type v} {d : ι → ℕ}

/-- Only boundary points are identified with their prescribed attaching images. -/
inductive AttachingRel (f : ∀ i : ι, C(Sphere (d i), X)) : Raw X d → Raw X d → Prop
  | boundary (i : ι) (z : Sphere (d i)) :
      AttachingRel f (.inr ⟨i, boundaryInclusion z⟩) (.inl (f i z))

/-- The adjunction quotient, with its induced quotient topology. -/
def Space (f : ∀ i : ι, C(Sphere (d i), X)) := Quot (AttachingRel f)

instance (f : ∀ i : ι, C(Sphere (d i), X)) : TopologicalSpace (Space f) :=
  inferInstanceAs (TopologicalSpace (Quot (AttachingRel f)))

/-- The quotient map from the unglued topological disjoint union. -/
def quotientMap (f : ∀ i : ι, C(Sphere (d i), X)) : C(Raw X d, Space f) :=
  ⟨Quot.mk _, continuous_quot_mk⟩

/-- The actual continuous inclusion of the original space. -/
def inclusion (f : ∀ i : ι, C(Sphere (d i), X)) : C(X, Space f) where
  toFun x := quotientMap f (.inl x)
  continuous_toFun := (quotientMap f).continuous.comp continuous_inl

/-- The characteristic map of an attached closed disk. -/
def characteristic (f : ∀ i : ι, C(Sphere (d i), X)) (i : ι) : C(Disk (d i), Space f) where
  toFun z := quotientMap f (.inr ⟨i, z⟩)
  continuous_toFun := (quotientMap f).continuous.comp
    (continuous_inr.comp (continuous_sigmaMk (i := i)))

@[simp] theorem characteristic_boundary (f : ∀ i : ι, C(Sphere (d i), X)) (i : ι) (z : Sphere (d i)) :
    characteristic f i (boundaryInclusion z) = inclusion f (f i z) :=
  Quot.sound (.boundary i z)

/-- The quotient map is a quotient map, not merely a continuous surjection. -/
theorem quotientMap_isQuotientMap (f : ∀ i : ι, C(Sphere (d i), X)) :
    Topology.IsQuotientMap (quotientMap f) := isQuotientMap_quot_mk

/-- Identify the boundary point of a disk with a sphere point. -/
def diskBoundaryPoint {n : ℕ} (z : Disk n) (h : ‖(z : Euclid n)‖ = 1) : Sphere n :=
  ⟨z, mem_sphere_zero_iff_norm.mpr h⟩

/-- An algebraic invariant used only to distinguish points of the original space.
It is deliberately not asserted to be continuous. -/
def baseValue (f : ∀ i : ι, C(Sphere (d i), X)) : Raw X d → Option X
  | .inl x => some x
  | .inr ⟨i, z⟩ => if h : ‖(z : Euclid (d i))‖ = 1 then some (f i (diskBoundaryPoint z h)) else none

theorem baseValue_respects (f : ∀ i : ι, C(Sphere (d i), X)) {a b : Raw X d}
    (h : AttachingRel f a b) : baseValue f a = baseValue f b := by
  cases h with
  | boundary i z =>
    change (if h : ‖(z : Euclid (d i))‖ = 1 then some (f i (diskBoundaryPoint (boundaryInclusion z) h)) else none) = some (f i z)
    rw [dite_eq_left (Sphere.norm_coe z)]
    rfl

/-- Algebraic readout of the base value descends through precisely the attaching relation. -/
def quotientBaseValue (f : ∀ i : ι, C(Sphere (d i), X)) : Space f → Option X :=
  Quot.lift (baseValue f) (fun _ _ h => baseValue_respects f h)

/-- The attaching quotient never identifies two distinct original points. -/
theorem inclusion_injective (f : ∀ i : ι, C(Sphere (d i), X)) : Function.Injective (inclusion f) := by
  intro x y h
  have h' := congrArg (quotientBaseValue f) h
  exact Option.some.inj h'

/-- The specified map on fundamental groups is induced by the actual inclusion. -/
def inclusionPi1 (f : ∀ i : ι, C(Sphere (d i), X)) (x₀ : X) :
    FundamentalGroup X x₀ →* FundamentalGroup (Space f) (inclusion f x₀) :=
  FundamentalGroup.map (inclusion f) x₀

end HigherCellAttachment
end
end HigherCellAttachment_Adjunction

/-! Source module: HigherCellAttachment.Statement -/
section HigherCellAttachment_Statement
noncomputable section
namespace HigherCellAttachment
universe u v
/-- Attaching an arbitrary family of genuine closed cells of independently
varying dimensions at least three preserves the actual based fundamental
group. The displayed equivalence has exactly the inclusion-induced homomorphism. -/
def completeStatement : Prop :=
  ∀ (X : Type u) [TopologicalSpace X] [PathConnectedSpace X]
    (ι : Type v) (d : ι → ℕ) (_hd : ∀ i, 3 ≤ d i)
    (f : ∀ i : ι, C(Sphere (d i), X)) (x₀ : X),
    Function.Bijective (inclusionPi1 f x₀) ∧
      ∃ E : FundamentalGroup X x₀ ≃* FundamentalGroup (Space f) (inclusion f x₀),
        E.toMonoidHom = inclusionPi1 f x₀
end HigherCellAttachment
end
end HigherCellAttachment_Statement

namespace HigherCellAttachment
universe u v
/-- Independent full mixed-dimension, arbitrary-family attachment challenge. -/
theorem higher_cell_attachment : completeStatement.{u,v} := by
  sorry
end HigherCellAttachment
